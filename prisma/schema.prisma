generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         String // ADMIN | TEACHER | STUDENT | PARENT
  displayName  String
  phone        String?
  email        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  groupsTaught  Group[]             @relation("TeacherGroups")
  assignments   Assignment[]        @relation("TeacherAssignments")
  studentRecord Student?            @relation("StudentUser")
  parentOf      ParentOfStudent[]   @relation("ParentUser")
}

model Group {
  id          String   @id @default(cuid())
  name        String
  direction   String   @default("")
  teacherId   String
  teacher     User     @relation("TeacherGroups", fields: [teacherId], references: [id], onDelete: Cascade)
  students    Student[]
  assignments Assignment[]
  createdAt   DateTime @default(now())
}

model Student {
  id          String   @id @default(cuid())
  groupId     String
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String
  phone       String   @default("")
  userId      String?  @unique
  user        User?    @relation("StudentUser", fields: [userId], references: [id], onDelete: SetNull)
  parents     ParentOfStudent[]
  submissions Submission[]
  subjectGrades SubjectGrade[]
  payments    Payment[]
  createdAt   DateTime @default(now())
}

model ParentOfStudent {
  id           String  @id @default(cuid())
  studentId    String
  student      Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parentUserId String
  parent       User    @relation("ParentUser", fields: [parentUserId], references: [id], onDelete: Cascade)

  @@unique([studentId, parentUserId])
}

model Assignment {
  id          String   @id @default(cuid())
  groupId     String
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teacherId   String
  teacher     User     @relation("TeacherAssignments", fields: [teacherId], references: [id], onDelete: Cascade)
  title       String
  description String   @default("")
  dueAt       DateTime?
  createdAt   DateTime @default(now())
  files       AssignmentFile[]
  submissions Submission[]

  @@index([groupId])
}

model AssignmentFile {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  filename     String
  storedName   String
  mimeType     String
  kind         String   @default("OTHER") // PDF | VIDEO | IMAGE | OTHER
  size         Int        @default(0)
}

model Submission {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  comment      String     @default("")
  submittedAt  DateTime   @default(now())
  files        SubmissionFile[]
  grade        SubmissionGrade?

  @@unique([assignmentId, studentId])
}

model SubmissionFile {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  filename     String
  storedName   String
  mimeType     String
  size         Int        @default(0)
}

model SubmissionGrade {
  id              String     @id @default(cuid())
  submissionId  String     @unique
  submission      Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  score           Int?
  teacherComment  String     @default("")
  gradedAt        DateTime   @default(now())
  gradedById      String
}

model SubjectGrade {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject   String
  period    String
  score     Float?
  maxScore  Float    @default(100)
  note      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, subject, period])
}

model Payment {
  id              String          @id @default(cuid())
  studentId       String
  student         Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amountCents     Int
  paidAmountCents Int             @default(0)
  currency        String          @default("UZS")
  dueDate         DateTime
  status          String // PAID | DEBT | PARTIAL
  note            String          @default("")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  reminders       PaymentReminder[]
}

model PaymentReminder {
  id        String   @id @default(cuid())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  channel   String
  sentAt    DateTime @default(now())
  meta      String   @default("")
}
